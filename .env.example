# ---- Shopify app credentials ----
# myshop.myshopify.com  (no protocol, no trailing slash)
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# Client credentials. The app exchanges these for an Admin API access token at
# POST https://<shop>/admin/oauth/access_token (grant_type=client_credentials) and fetches a
# new one before it expires (tokens last ~24h), so no token is stored anywhere.
# Server-side only; never exposed to the browser.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Admin GraphQL API version
SHOPIFY_API_VERSION=2025-07

# ---- Legacy fallback ----
# A static, non-expiring token (shpat_...) from an app made under Settings -> Apps ->
# Develop apps. Used only when SHOPIFY_CLIENT_ID / SHOPIFY_CLIENT_SECRET are not set.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# ---- Optional: embedded admin UI ----
# Only needed if you also created an app in the Partner Dashboard / Shopify CLI so the
# app can render inside the Shopify admin. Leave blank to run standalone in a browser tab.
NEXT_PUBLIC_SHOPIFY_API_KEY=

# ---- Optional: gate the public tunnel URL ----
# If set, every request must present ?k=<value> once; a cookie is then set for the session.
APP_SHARED_SECRET=

NEXT_PUBLIC_DB_URL=mongodb+srv://<db_username>:<db_password>@cluster0.5rrul.mongodb.net/?appName=Cluster0

# ---- Storage ----
# MongoDB connection string. Required on Vercel (its filesystem is read-only); without it
# the app stores everything as JSON files under ./data, which only suits local development.
# Holds credentials: never prefix it with NEXT_PUBLIC_, which would ship it to the browser.
MONGODB_URI=
MONGODB_DB=gst_invoice
